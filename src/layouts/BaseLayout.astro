---
import { Font } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'
import GridField from '@/components/fx/GridField.astro'
import SiteFooter from '@/components/layout/SiteFooter.astro'
import SiteHeader from '@/components/layout/SiteHeader.astro'
import { shortNotice } from '@/data/rights'
import { SITE } from '@/data/site'
import {
  alternates,
  DEFAULT_LOCALE,
  getDictionary,
  LOCALES,
  type Locale,
  type RouteRef,
} from '@/i18n'
import { OG_LOCALES } from '@/i18n/config'
import { absolute, OG_SIZE, ogImagePath, PREVIEW, schemaGraph, urlFor } from '@/lib/seo'
import { pageTransition } from '@/lib/transitions'
import '@/styles/global.css'

interface Props {
  locale: Locale
  route: RouteRef
  title: string
  description: string
  noindex?: boolean
  /** Los nodos de schema.org propios de la página; el sitio y la persona se suman solos. */
  schema?: Record<string, unknown>[]
}

const { locale, route, title, description, noindex = false, schema } = Astro.props
const t = getDictionary(locale)
const canonical = urlFor(locale, route)
const ogImage = absolute(ogImagePath(locale, route))
const jsonLd = schema && (await schemaGraph(locale, schema))

/**
 * El aviso de derechos, corto, como comentario HTML antes de `<html>`: es lo primero en
 * «Elementos» y en el código fuente. Se repite en la consola; el entero está en llms.txt.
 */
const policy = absolute('/llms.txt')
const comment = (lines: string[]) =>
  `<!--\n${lines.map((line) => (line ? `  ${line}` : '')).join('\n')}\n-->`
const consoleNotice = shortNotice(policy)
---

<!doctype html>
<Fragment set:html={comment(consoleNotice)} />
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    {noindex || PREVIEW ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {alternates(route).map((alt) => (
          <link rel="alternate" hreflang={alt.locale} href={absolute(alt.path)} />
        ))}
        <link rel="alternate" hreflang="x-default" href={urlFor(DEFAULT_LOCALE, route)} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {LOCALES.filter((other) => other !== locale).map((other) => (
      <meta property="og:locale:alternate" content={OG_LOCALES[other]} />
    ))}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_SIZE.width)} />
    <meta property="og:image:height" content={String(OG_SIZE.height)} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-departure" preload />
    <Font cssVariable="--font-instrument" />
    {/*
      Bloqueante a propósito: el tema guardado se aplica antes del primer pintado. Sin
      almacenamiento disponible, queda el oscuro. Los scripts `is:inline` se publican tal
      cual: sus comentarios van aquí afuera, nunca adentro.
    */}
    <script is:inline>
      ;(() => {
        const stored = () => {
          try {
            return localStorage.getItem('theme')
          } catch {
            return null
          }
        }
        const apply = () => {
          document.documentElement.dataset.theme = stored() === 'light' ? 'light' : 'dark'
        }
        apply()
        document.addEventListener('astro:after-swap', apply)
      })()
    </script>
    {/*
      Chrome, Edge y Firefox en iOS: al volver con el gesto, se saltan las entradas del
      historial que una página crea sin un toque reciente, y con ellas la anterior (la
      que el usuario cree estar viendo). El router crea la de cada página al terminar de
      bajarla, y en Chrome para iOS quedaba así marcada: atrás desde /proyectos salía
      del sitio. Aquí se crea en el mismo toque, con la forma del estado del router, que
      después la encuentra puesta y no la repite. Va antes del router: sus manejadores
      corren después de estos. Las mismas condiciones que él para tomar un enlace o un
      formulario GET (ver ClientRouter.astro de Astro).
    */}
    <script is:inline>
      ;(() => {
        if (!/(CriOS|EdgiOS|FxiOS)\//.test(navigator.userAgent)) return
        const advance = (href) => {
          const url = new URL(href, location.href)
          const here = new URL(location.href)
          if (url.origin !== here.origin || url.href === here.href) return
          if (url.pathname === here.pathname && url.search === here.search) return
          const state = history.state ?? { index: 0 }
          history.replaceState({ ...state, scrollX, scrollY }, '')
          history.pushState({ index: (state.index ?? 0) + 1, scrollX: 0, scrollY: 0 }, '', url)
        }
        document.addEventListener('click', (ev) => {
          const link = ev.target instanceof Element ? ev.target.closest('a, area') : null
          if (!link || !link.href || ev.defaultPrevented) return
          if (ev.button || ev.metaKey || ev.ctrlKey || ev.altKey || ev.shiftKey) return
          if (link.hasAttribute('data-astro-reload') || link.hasAttribute('download')) return
          if (link.dataset.astroHistory === 'replace') return
          if (link.target && link.target !== '_self') return
          advance(link.href)
        })
        document.addEventListener('submit', (ev) => {
          const form = ev.target
          if (!(form instanceof HTMLFormElement) || ev.defaultPrevented) return
          if (form.hasAttribute('data-astro-reload')) return
          const method = ev.submitter?.getAttribute('formmethod') ?? form.method
          if (method !== 'get') return
          const url = new URL(ev.submitter?.getAttribute('formaction') ?? form.action)
          url.search = new URLSearchParams(new FormData(form, ev.submitter)).toString()
          advance(url.href)
        })
      })()
    </script>
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <script is:inline define:vars={{ consoleNotice }}>
      console.info(`%c${consoleNotice.join('\n')}`, 'color:#ffb000;font-weight:bold')
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.a11y.skip}
    </a>
    <GridField />
    <SiteHeader locale={locale} route={route} />
    <main id="main" class="site-layer" transition:name="page" transition:animate={pageTransition}>
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
