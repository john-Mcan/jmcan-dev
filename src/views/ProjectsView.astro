---
import ProjectList from '@/components/projects/ProjectList.astro'
import UpLink from '@/components/ui/UpLink.astro'
import { SITE } from '@/data/site'
import { fill, getDictionary, pathFor, type Locale } from '@/i18n'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getProjects, yearSpan } from '@/lib/projects'
import { breadcrumbs, pageNode, urlFor } from '@/lib/seo'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getDictionary(locale)
const projects = await getProjects(locale)
const count = fill(t.projects.indexCount, { count: projects.length, years: yearSpan(projects) })
const route = { key: 'projects' } as const
const title = `${t.meta.projectsTitle} | ${SITE.name}`

const schema = [
  pageNode('CollectionPage', locale, route, {
    name: title,
    description: t.meta.projectsDescription,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: projects.map((project, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: project.entry.data.title,
        url: urlFor(locale, { key: 'project', slug: project.slug }),
      })),
    },
  }),
  breadcrumbs(locale, [
    { name: t.nav.home, route: { key: 'home' } },
    { name: t.nav.projects, route },
  ]),
]
---

<BaseLayout
  locale={locale}
  route={route}
  title={title}
  description={t.meta.projectsDescription}
  schema={schema}
>
  {/* Un índice: el título cerca del header, una bajada corta y cuántos hay, para orientarse. */}
  <section class="container-site pt-4 pb-10 md:pt-10 md:pb-16">
    <UpLink href={pathFor(locale, 'home')} label={t.nav.home} name={t.nav.upHome} />
    <h1 class="font-pixel text-d3 md:text-d4 mt-4 md:mt-10">
      <span class="inline-block" data-grid-shape>
        {t.projects.indexTitle}
      </span>
    </h1>
    <p class="sm:text-lead text-muted mt-4 max-w-[36ch] text-lg sm:mt-6 sm:max-w-[40ch]">
      {t.projects.indexLead}
    </p>
    <p class="text-muted mt-5 text-sm tabular-nums sm:mt-6">{count}</p>
  </section>
  <section class="container-site" aria-label={t.projects.indexTitle}>
    <ProjectList locale={locale} projects={projects} headingLevel="h2" />
  </section>
</BaseLayout>
