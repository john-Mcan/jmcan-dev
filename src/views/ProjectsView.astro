---
import ProjectList from '@/components/projects/ProjectList.astro'
import { SITE } from '@/data/site'
import { getDictionary, type Locale } from '@/i18n'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getProjects } from '@/lib/projects'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getDictionary(locale)
const projects = await getProjects(locale)
---

<BaseLayout
  locale={locale}
  route={{ key: 'projects' }}
  title={`${t.meta.projectsTitle} | ${SITE.name}`}
  description={t.meta.projectsDescription}
>
  <section class="container-site pt-16 pb-12 md:pt-24 md:pb-16">
    <h1 class="font-pixel text-d3 md:text-d4">
      <span class="inline-block" data-grid-shape>
        {t.projects.indexTitle}
      </span>
    </h1>
    <p class="text-lead text-muted mt-6 max-w-[40ch]">{t.projects.indexLead}</p>
  </section>
  <section class="container-site" aria-label={t.projects.indexTitle}>
    <ProjectList locale={locale} projects={projects} headingLevel="h2" />
  </section>
</BaseLayout>
