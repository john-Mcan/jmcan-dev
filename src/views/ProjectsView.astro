---
import ProjectList from '@/components/projects/ProjectList.astro'
import UpLink from '@/components/ui/UpLink.astro'
import { SITE } from '@/data/site'
import { fill, getDictionary, pathFor, type Locale } from '@/i18n'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getProjects, yearSpan } from '@/lib/projects'
import { breadcrumbs, pageNode, urlFor } from '@/lib/seo'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getDictionary(locale)
const projects = await getProjects(locale)
const count = fill(t.projects.indexCount, { count: projects.length, years: yearSpan(projects) })
const route = { key: 'projects' } as const
const title = `${t.meta.projectsTitle} | ${SITE.name}`

const schema = [
  pageNode('CollectionPage', locale, route, {
    name: title,
    description: t.meta.projectsDescription,
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: projects.map((project, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: project.entry.data.title,
        url: urlFor(locale, { key: 'project', slug: project.slug }),
      })),
    },
  }),
  breadcrumbs(locale, [
    { name: t.nav.home, route: { key: 'home' } },
    { name: t.nav.projects, route },
  ]),
]
---

<BaseLayout
  locale={locale}
  route={route}
  title={title}
  description={t.meta.projectsDescription}
  schema={schema}
>
  {/*
    Encabezado separado de la lista con una línea fuerte y la bajada en --fg-soft:
    en un teléfono, el título queda como bloque propio y no se mezcla con las filas.
    El conteo encabeza la lista, justo sobre su borde fino.
  */}
  <header class="container-site pt-4 md:pt-10">
    <div class="border-line-strong border-b pb-8 md:pb-12">
      <UpLink href={pathFor(locale, 'home')} label={t.nav.home} name={t.nav.upHome} />
      <h1 class="font-pixel text-d3 md:text-d4 mt-6 md:mt-10">
        <span class="inline-block" data-grid-shape>
          {t.projects.indexTitle}
        </span>
      </h1>
      <p class="sm:text-lead text-fg-soft mt-4 max-w-[36ch] text-lg sm:mt-6 sm:max-w-[40ch]">
        {t.projects.indexLead}
      </p>
    </div>
  </header>
  <section class="container-site pt-8 md:pt-12" aria-label={t.projects.indexTitle}>
    <p class="text-muted mb-3 text-sm tabular-nums md:mb-6">{count}</p>
    <ProjectList locale={locale} projects={projects} headingLevel="h2" />
  </section>
</BaseLayout>
