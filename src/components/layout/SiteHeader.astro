---
/**
 * El header, siempre a mano y compacto desde la carga: arriba de todo es
 * transparente y, al bajar, toma fondo y una línea fina. El logo es un prompt,
 * `jm ~/<ruta>▮`: la ruta dice dónde estás y, en la home, sigue a la sección a la
 * vista (`data-prompt`). Cambia tecla a tecla: borra la ruta de antes y escribe la
 * nueva, también al cambiar de página. En móvil se esconde al bajar y vuelve al
 * subir. Sin `backdrop-filter`: detrás hay un canvas que repinta a 30 fps y el blur
 * se recalcularía en cada cuadro.
 */
import LangSwitch from '@/components/layout/LangSwitch.astro'
import ThemeToggle from '@/components/layout/ThemeToggle.astro'
import { SITE } from '@/data/site'
import {
  getDictionary,
  pathFor,
  promptPath,
  type Locale,
  type RouteKey,
  type RouteRef,
} from '@/i18n'

interface Props {
  locale: Locale
  route: RouteRef
}

const { locale, route } = Astro.props
const t = getDictionary(locale)
const path = promptPath(locale, route)

const items: { key: RouteKey; label: string; active: boolean }[] = [
  {
    key: 'projects',
    label: t.nav.projects,
    active: route.key === 'projects' || route.key === 'project',
  },
  { key: 'contact', label: t.nav.contact, active: route.key === 'contact' },
]
---

<header class="site-header" data-site-header>
  <div class="header-bar" transition:name="site-header" transition:animate="none">
    <div class="container-site flex h-full items-center justify-between gap-4">
      <a
        href={pathFor(locale, 'home')}
        class="prompt font-pixel text-d1"
        aria-label={`${SITE.name}, ${t.nav.home}`}
      >
        <span>jm</span>
        <span class="prompt-path text-muted">
          ~/<span data-prompt-path={path}>{path}</span>
        </span>
        <span class="prompt-cursor" aria-hidden="true"></span>
      </a>
      <div class="flex flex-none items-center gap-5 sm:gap-8">
        <nav aria-label={t.a11y.mainNav}>
          <ul class="flex gap-4 text-[0.9375rem] sm:gap-6">
            {items.map((item) => (
              <li>
                <a
                  href={pathFor(locale, item.key)}
                  aria-current={item.active ? 'page' : undefined}
                  class:list={[
                    'nav-link py-2',
                    item.active ? 'text-fg' : 'text-muted hover:text-fg',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="flex items-center gap-3">
          <LangSwitch locale={locale} route={route} />
          <ThemeToggle locale={locale} />
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  /* Ocupa su alto en el flujo; la barra va fija encima, así esconderla no mueve la página. */
  .site-header {
    position: relative;
    z-index: 10;
    height: var(--header-h);
  }
  .header-bar {
    position: fixed;
    inset: 0 0 auto;
    height: var(--header-h);
    border-bottom: 1px solid transparent;
    transition:
      background-color 160ms steps(4, end),
      border-color 160ms steps(4, end),
      transform 200ms steps(5, end);
  }
  [data-scrolled] .header-bar {
    border-bottom-color: var(--line);
    background: color-mix(in srgb, var(--bg) 90%, transparent);
  }
  /* Escondido al bajar (móvil), salvo que algo suyo tenga el foco. */
  [data-hidden]:not(:focus-within) .header-bar {
    transform: translateY(-100%);
  }
  /* La página nueva toma su estado de golpe, sin animarlo. */
  [data-settling] .header-bar {
    transition: none;
  }

  .prompt {
    display: flex;
    min-width: 0;
    align-items: center;
    white-space: nowrap;
  }
  /* En un teléfono no entra junto a la navegación: queda `jm▮`. */
  .prompt-path {
    display: none;
    min-width: 0;
    /* El espacio entre `jm` y `~/`: en la fuente mono, 1ch es justo un espacio. */
    margin-left: 1ch;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (min-width: 40rem) {
    .prompt-path {
      display: block;
    }
  }
  /*
   * El cursor del prompt: un bloque en ámbar (estado). Parpadea solo con la página bajada; arriba
   * de todo y mientras escribe, queda quieto.
   */
  .prompt-cursor {
    width: 0.5em;
    height: 0.8em;
    flex: none;
    margin-left: 0.125em;
    background: var(--signal);
    animation: prompt-blink 1.1s steps(1, end) infinite;
  }
  .site-header:not([data-scrolled]) .prompt-cursor,
  .prompt[data-typing] .prompt-cursor {
    animation: none;
  }
  @keyframes prompt-blink {
    50% {
      opacity: 0;
    }
  }

  .nav-link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.5em;
  }

  @media (prefers-reduced-motion: reduce) {
    .header-bar {
      transition: none;
    }
    .prompt-cursor {
      animation: none;
    }
  }
</style>

<script>
  import { createTypewriter, type Typewriter } from '@/lib/typewriter'

  /** Mismo corte que `md:` de Tailwind: desde aquí el header no se esconde. */
  const WIDE = window.matchMedia('(min-width: 48rem)')
  /** Desde cuántos px toma fondo y desde cuántos puede esconderse (móvil). */
  const SOLID_AT = 8
  const HIDE_AFTER = 64
  /** Cuánto hay que moverse para que cambie de rumbo: un temblor del dedo no lo mueve. */
  const TURN = 6

  let header: HTMLElement | null = null
  let lastY = 0
  let queued = false
  let sections: IntersectionObserver | null = null
  let prompt: Typewriter | null = null

  function update(): void {
    queued = false
    if (!header) return
    const y = Math.max(0, window.scrollY)
    header.toggleAttribute('data-scrolled', y > SOLID_AT)
    if (WIDE.matches || y <= HIDE_AFTER) {
      header.removeAttribute('data-hidden')
      lastY = y
      return
    }
    const delta = y - lastY
    if (Math.abs(delta) < TURN) return
    header.toggleAttribute('data-hidden', delta > 0)
    lastY = y
  }

  function queue(): void {
    if (queued) return
    queued = true
    requestAnimationFrame(update)
  }

  /**
   * El prompt escribe la ruta de la página (`data-prompt-path`). Al llegar de otra,
   * arranca con la ruta que había (la deja `astro:before-swap`) y la cambia tecla a tecla.
   */
  function typePath(): void {
    prompt?.stop()
    prompt = null
    const path = header?.querySelector<HTMLElement>('[data-prompt-path]')
    if (!path) return
    prompt = createTypewriter(path, path.closest<HTMLElement>('.prompt') ?? path)
    prompt.type(path.dataset['promptPath'] ?? '')
  }

  /** En la home, la ruta del prompt es la de la sección que cruza el medio de la pantalla. */
  function followSections(): void {
    sections?.disconnect()
    sections = null
    const marked = document.querySelectorAll<HTMLElement>('[data-prompt]')
    if (marked.length === 0) return
    sections = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && entry.target instanceof HTMLElement) {
            prompt?.type(entry.target.dataset['prompt'] ?? '')
          }
        }
      },
      { rootMargin: '-45% 0px -45% 0px' },
    )
    for (const section of marked) sections.observe(section)
  }

  window.addEventListener('scroll', queue, { passive: true })
  WIDE.addEventListener('change', queue)

  // La página nueva muestra la ruta de la que se va: desde ahí la cambia escribiendo.
  document.addEventListener('astro:before-swap', (event) => {
    const before = document.querySelector('[data-prompt-path]')
    const after = event.newDocument.querySelector('[data-prompt-path]')
    if (before && after) after.textContent = before.textContent
  })

  // El header se reemplaza en cada navegación: el nuevo toma el estado del scroll de su página.
  document.addEventListener('astro:page-load', () => {
    header = document.querySelector('[data-site-header]')
    if (!header) return
    const settling = header
    settling.setAttribute('data-settling', '')
    lastY = Math.max(0, window.scrollY)
    update()
    requestAnimationFrame(() =>
      requestAnimationFrame(() => settling.removeAttribute('data-settling')),
    )
    typePath()
    followSections()
  })
</script>
