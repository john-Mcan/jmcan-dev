---
/**
 * El header, siempre a mano y compacto desde la carga: arriba de todo es
 * transparente y, al bajar, toma fondo y una línea fina. El logo es un prompt,
 * `jm ~/<ruta>▮`: la ruta dice dónde estás y, en la home, sigue a la sección a la
 * vista (`data-prompt`). Cambia tecla a tecla: borra la ruta de antes y escribe la
 * nueva, también al cambiar de página. Fuera de la home, la ruta son migas: cada
 * tramo lleva a su nivel (`~` al inicio, `proyectos` a la lista), como `cd ..`.
 *
 * En un teléfono la ruta no entra junto a la navegación. En la home, al bajar, el
 * header es solo el prompt y escribe la ruta; al subir, la borra y vuelve la
 * navegación. En las demás páginas (`data-trail`) la ruta queda fija, con el idioma
 * y el tema: dice dónde estás y sube de nivel.
 *
 * Sin `backdrop-filter`: detrás hay un canvas que repinta a 30 fps y el blur se
 * recalcularía en cada cuadro.
 */
import LangSwitch from '@/components/layout/LangSwitch.astro'
import ThemeToggle from '@/components/layout/ThemeToggle.astro'
import { SITE } from '@/data/site'
import {
  getDictionary,
  pathFor,
  promptPath,
  type Locale,
  type RouteKey,
  type RouteRef,
} from '@/i18n'

interface Props {
  locale: Locale
  route: RouteRef
}

const { locale, route } = Astro.props
const t = getDictionary(locale)
const path = promptPath(locale, route)

/** Las migas de la ruta (`~`, los niveles de arriba y la página), con a dónde lleva cada una. */
const crumbs: { text: string; href?: string }[] = []
if (route.key !== 'home') {
  crumbs.push({ text: '~', href: pathFor(locale, 'home') })
  const parent = route.key === 'project' ? promptPath(locale, 'projects') : ''
  if (parent) crumbs.push({ text: parent, href: pathFor(locale, 'projects') })
  crumbs.push({ text: parent ? path.slice(parent.length + 1) : path })
}

const items: { key: RouteKey; label: string; active: boolean }[] = [
  {
    key: 'projects',
    label: t.nav.projects,
    active: route.key === 'projects' || route.key === 'project',
  },
  { key: 'contact', label: t.nav.contact, active: route.key === 'contact' },
]
---

<header
  class="site-header"
  data-site-header
  data-trail={crumbs.length > 0 ? '' : undefined}
  data-crumbs={crumbs.length > 0 ? JSON.stringify(crumbs) : undefined}
>
  <div class="header-bar" transition:name="site-header" transition:animate="none">
    <div class="container-site flex h-full items-center justify-between gap-4">
      <div class="prompt font-pixel text-d1">
        <a href={pathFor(locale, 'home')} aria-label={`${SITE.name}, ${t.nav.home}`}>
          jm
        </a>
        <span class="prompt-path text-muted" data-prompt-path={path}>
          ~/{path}
        </span>
        <span class="prompt-cursor" aria-hidden="true"></span>
      </div>
      <div class="header-tools flex flex-none items-center gap-5 sm:gap-8">
        <nav aria-label={t.a11y.mainNav}>
          <ul class="flex gap-4 text-[0.9375rem] sm:gap-6">
            {items.map((item) => (
              <li>
                <a
                  href={pathFor(locale, item.key)}
                  aria-current={item.active ? 'page' : undefined}
                  class:list={[
                    'nav-link py-2',
                    item.active ? 'text-fg' : 'text-muted hover:text-fg',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="flex items-center gap-3">
          <LangSwitch locale={locale} route={route} />
          <ThemeToggle locale={locale} />
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  /* Ocupa su alto en el flujo; la barra va fija encima. */
  .site-header {
    position: relative;
    z-index: 10;
    height: var(--header-h);
  }
  .header-bar {
    position: fixed;
    inset: 0 0 auto;
    height: var(--header-h);
    border-bottom: 1px solid transparent;
    transition:
      background-color 160ms steps(4, end),
      border-color 160ms steps(4, end);
  }
  [data-scrolled] .header-bar {
    border-bottom-color: var(--line);
    background: color-mix(in srgb, var(--bg) 90%, transparent);
  }
  /* La página nueva toma su estado de golpe, sin animarlo. */
  [data-settling] .header-bar {
    transition: none;
  }

  .prompt {
    display: flex;
    min-width: 0;
    align-items: center;
    white-space: nowrap;
  }
  .prompt-path {
    min-width: 0;
    /* El espacio entre `jm` y `~/`: en la fuente mono, 1ch es justo un espacio. */
    margin-left: 1ch;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* Borrada del todo, sin su espacio: queda `jm▮`. */
  .prompt-path:empty {
    display: none;
  }
  /* Las migas: el color de la ruta; subrayadas en ámbar (interacción) al pasar el puntero. */
  .prompt-path :global(.crumb) {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    transition: text-decoration-color 120ms steps(3, end);
  }
  .prompt-path :global(.crumb:hover) {
    text-decoration-color: var(--signal);
  }
  .prompt-path :global([aria-current='page']) {
    color: var(--fg);
  }
  /*
   * En un teléfono las migas se tocan en casi todo el alto del header. O la ruta o la
   * navegación: en la home, arriba de todo y al subir, `jm▮` y la navegación; al bajar
   * (`data-prompting`), solo el prompt. En las demás páginas (`data-trail`), la ruta fija,
   * con el idioma y el tema.
   */
  @media (width < 40rem) {
    .prompt-path,
    .prompt-path :global(.crumb) {
      padding-block: 0.5rem;
    }
    .site-header:not([data-prompting], [data-trail]) .prompt-path,
    [data-prompting] .header-tools,
    [data-trail] nav {
      display: none;
    }
  }
  /*
   * El cursor del prompt: un bloque en ámbar (estado). Parpadea solo con la página bajada; arriba
   * de todo y mientras escribe, queda quieto.
   */
  .prompt-cursor {
    width: 0.5em;
    height: 0.8em;
    flex: none;
    margin-left: 0.125em;
    background: var(--signal);
    animation: prompt-blink 1.1s steps(1, end) infinite;
  }
  .site-header:not([data-scrolled]) .prompt-cursor,
  .prompt[data-typing] .prompt-cursor {
    animation: none;
  }
  @keyframes prompt-blink {
    50% {
      opacity: 0;
    }
  }

  .nav-link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.5em;
  }

  @media (prefers-reduced-motion: reduce) {
    .header-bar {
      transition: none;
    }
    .prompt-cursor {
      animation: none;
    }
  }
</style>

<script>
  import { createTypewriter, type Typewriter } from '@/lib/typewriter'

  /** Mismo corte que `sm:` de Tailwind: desde aquí la ruta entra junto a la navegación. */
  const ROOMY = window.matchMedia('(min-width: 40rem)')
  /** Desde cuántos px toma fondo y, en un teléfono, desde cuántos puede quedar solo el prompt. */
  const SOLID_AT = 8
  const PROMPT_AFTER = 64
  /** Cuánto hay que moverse para que cambie de rumbo: un temblor del dedo no lo mueve. */
  const TURN = 6
  /**
   * En la home, la ruta es la de la última sección (`data-prompt`) cuyo borde de arriba
   * pasó esta línea (fracción del alto de la pantalla), o la de la última si se llegó al
   * final. Con el medio de la pantalla cambiaba antes de que se viera la sección: arriba
   * de su título hay un buen margen.
   */
  const SECTION_LINE = 0.25

  let header: HTMLElement | null = null
  let lastY = 0
  let queued = false
  let sections: HTMLElement[] = []
  let prompt: Typewriter | null = null
  /** Dónde estás, sin `~/`: la ruta de la página o, en la home, la de la sección a la vista. */
  let current = ''
  /** En un teléfono, en la home y bajando: el header es solo el prompt con la ruta. */
  let prompting = false
  /** Fuera de la home: la ruta, con sus migas, queda siempre a la vista. */
  let trail = false
  let crumbs: { text: string; href?: string }[] = []

  /**
   * Escrita la ruta, sus tramos pasan a ser enlaces (mientras escribe, es texto). Solo si
   * lo escrito es la ruta de la página: en plena escritura de otra, no.
   */
  function linkCrumbs(): void {
    const path = header?.querySelector<HTMLElement>('[data-prompt-path]')
    if (!path || crumbs.length === 0) return
    if (path.textContent?.trim() !== crumbs.map((crumb) => crumb.text).join('/')) return
    const nodes: (Node | string)[] = []
    crumbs.forEach((crumb, i) => {
      if (i > 0) nodes.push('/')
      const node = document.createElement(crumb.href ? 'a' : 'span')
      node.textContent = crumb.text
      if (node instanceof HTMLAnchorElement && crumb.href) {
        node.href = crumb.href
        node.className = 'crumb'
      } else {
        node.setAttribute('aria-current', 'page')
      }
      nodes.push(node)
    })
    path.replaceChildren(...nodes)
  }

  /**
   * Lleva el prompt a lo que corresponde. En un teléfono, al dejar de ser solo el
   * prompt, primero borra la ruta y recién entonces vuelve la navegación.
   */
  function write(): void {
    const to = ROOMY.matches || prompting || trail ? `~/${current}` : ''
    prompt?.type(to, () => {
      if (!prompting) header?.removeAttribute('data-prompting')
      linkCrumbs()
    })
  }

  function setPrompting(next: boolean): void {
    if (next === prompting) return
    prompting = next
    if (next) header?.setAttribute('data-prompting', '')
    write()
  }

  function follow(): void {
    if (sections.length === 0) return
    const line = window.innerHeight * SECTION_LINE
    const end = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2
    let at = sections[0]
    for (const section of sections) {
      if (end || section.getBoundingClientRect().top <= line) at = section
    }
    const path = at?.dataset['prompt'] ?? ''
    if (path === current) return
    current = path
    write()
  }

  function update(): void {
    queued = false
    if (!header) return
    follow()
    const y = Math.max(0, window.scrollY)
    header.toggleAttribute('data-scrolled', y > SOLID_AT)
    if (ROOMY.matches || trail || y <= PROMPT_AFTER) {
      setPrompting(false)
      lastY = y
      return
    }
    const delta = y - lastY
    if (Math.abs(delta) < TURN) return
    // Bajando, solo el prompt; subiendo, la navegación. No la saca si algo suyo tiene el foco.
    if (delta < 0 || !header.matches(':focus-within')) setPrompting(delta > 0)
    lastY = y
  }

  function queue(): void {
    if (queued) return
    queued = true
    requestAnimationFrame(update)
  }

  window.addEventListener('scroll', queue, { passive: true })
  ROOMY.addEventListener('change', () => {
    update()
    write()
  })

  // La página nueva muestra la ruta de la que se va: desde ahí la cambia escribiendo.
  document.addEventListener('astro:before-swap', (event) => {
    const before = document.querySelector('[data-prompt-path]')
    const after = event.newDocument.querySelector('[data-prompt-path]')
    if (before && after) after.textContent = before.textContent
  })

  // El header se reemplaza en cada navegación: el nuevo toma el estado del scroll de su página.
  document.addEventListener('astro:page-load', () => {
    header = document.querySelector('[data-site-header]')
    const path = header?.querySelector<HTMLElement>('[data-prompt-path]')
    if (!header || !path) return
    const settling = header
    settling.setAttribute('data-settling', '')
    current = path.dataset['promptPath'] ?? ''
    sections = [...document.querySelectorAll<HTMLElement>('[data-prompt]')]
    trail = header.hasAttribute('data-trail')
    crumbs = JSON.parse(header.dataset['crumbs'] ?? '[]') as typeof crumbs
    lastY = Math.max(0, window.scrollY)
    prompting = !ROOMY.matches && !trail && lastY > PROMPT_AFTER
    header.toggleAttribute('data-prompting', prompting)
    // En un teléfono, en la home con la navegación a la vista, la ruta llega borrada.
    if (!ROOMY.matches && !prompting && !trail) path.textContent = ''
    prompt?.stop()
    prompt = createTypewriter(path, path.closest<HTMLElement>('.prompt') ?? path)
    update()
    write()
    requestAnimationFrame(() =>
      requestAnimationFrame(() => settling.removeAttribute('data-settling')),
    )
  })
</script>
