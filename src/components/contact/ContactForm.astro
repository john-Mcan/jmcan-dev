---
/**
 * Funciona sin JS: el POST va a /api/contact, que redirige de vuelta con
 * `#enviado`, `#invalido` o `#error` y el CSS (`:target`) muestra el aviso. Con JS
 * se envía por fetch, el aviso aparece en línea y la grilla imprime «enviado».
 */
import { SITE } from '@/data/site'
import { fill, getDictionary, type Locale } from '@/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getDictionary(locale)
const errorSend = fill(t.contact.errorSend, { email: SITE.email })
---

<form
  method="post"
  action="/api/contact"
  class="grid gap-6"
  data-contact-form
  data-msg-sent={t.contact.sent}
  data-msg-invalid={t.contact.errorInvalid}
  data-msg-error={errorSend}
>
  <input type="hidden" name="locale" value={locale} />
  <input type="hidden" name="started" value="" />
  {/* Trampa para bots: invisible para personas, los bots suelen llenarla. */}
  <div class="hidden" aria-hidden="true">
    <label>
      Website <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <label class="grid gap-2">
      <span class="text-sm font-semibold">{t.contact.name}</span>
      <input class="field" type="text" name="name" required maxlength="80" autocomplete="name" />
    </label>
    <label class="grid gap-2">
      <span class="text-sm font-semibold">{t.contact.email}</span>
      <input
        class="field"
        type="email"
        name="email"
        required
        maxlength="120"
        autocomplete="email"
      />
    </label>
  </div>

  <label class="grid gap-2">
    <span class="text-sm font-semibold">{t.contact.message}</span>
    <textarea
      class="field min-h-48 resize-y"
      name="message"
      required
      minlength="10"
      maxlength="4000"
      aria-describedby="message-hint"
    ></textarea>
    <span id="message-hint" class="text-muted text-sm">
      {t.contact.messageHint}
    </span>
  </label>

  <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
    <button type="submit" class="btn btn-primary cursor-pointer" data-grid-shape>
      <span data-idle>{t.contact.submit}</span>
      <span data-busy hidden>
        {t.contact.sending}
      </span>
    </button>
    <p role="status" class="form-status" data-form-status></p>
  </div>

  <p id="enviado" class="form-flash" data-state="ok">
    {t.contact.sent}
  </p>
  <p id="invalido" class="form-flash" data-state="error">
    {t.contact.errorInvalid}
  </p>
  <p id="error" class="form-flash" data-state="error">
    {errorSend}
  </p>
</form>

<style>
  .form-flash {
    display: none;
  }
  .form-flash:target {
    display: block;
  }
  .form-status:empty {
    display: none;
  }
  .form-status[data-state='ok'],
  .form-flash[data-state='ok'] {
    color: var(--signal);
  }
  .form-status[data-state='error'],
  .form-flash[data-state='error'] {
    color: var(--fg);
    border-left: 2px solid var(--signal);
    padding-left: 0.75rem;
  }
</style>

<script>
  function init(): void {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]')
    if (!form) return
    const started = form.querySelector<HTMLInputElement>('input[name="started"]')
    if (started) started.value = String(Date.now())
    const status = form.querySelector<HTMLElement>('[data-form-status]')
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')

    const setBusy = (busy: boolean) => {
      if (!button) return
      button.disabled = busy
      button.querySelector<HTMLElement>('[data-idle]')?.toggleAttribute('hidden', busy)
      button.querySelector<HTMLElement>('[data-busy]')?.toggleAttribute('hidden', !busy)
    }
    const show = (state: 'ok' | 'error', message = '') => {
      if (!status) return
      status.dataset['state'] = state
      status.textContent = message
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      setBusy(true)
      show('ok')
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        })
        if (response.ok) {
          form.reset()
          show('ok', form.dataset['msgSent'])
          // La pantalla de contacto cambia «@» por «enviado».
          document
            .querySelector('[data-grid-stage="contact"]')
            ?.setAttribute('data-grid-stage', 'sent')
          document.dispatchEvent(new Event('grid:refresh'))
        } else {
          show(
            'error',
            response.status === 400 ? form.dataset['msgInvalid'] : form.dataset['msgError'],
          )
        }
      } catch {
        show('error', form.dataset['msgError'])
      } finally {
        setBusy(false)
      }
    })
  }

  document.addEventListener('astro:page-load', init)
</script>
