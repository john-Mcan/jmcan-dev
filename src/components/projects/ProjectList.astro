---
/**
 * Lista de proyectos con panel narrador: en escritorio, una pantalla sticky a la
 * izquierda donde la grilla imprime el glifo de la fila activa; en móvil, cada
 * fila tiene su propia caja con su glifo, que baja con ella (la activa, en ámbar).
 * En móvil el resumen va junto al glifo y el año con el stack, debajo, a todo el
 * ancho: en la columna angosta se cortaban en dos líneas. La lógica vive en
 * src/scripts/grid-field.ts.
 */
import { pathFor, type Locale } from '@/i18n'
import { period, type Project } from '@/lib/projects'

interface Props {
  locale: Locale
  projects: Project[]
  headingLevel?: 'h2' | 'h3'
}

const { locale, projects, headingLevel: Heading = 'h3' } = Astro.props
const first = projects[0]?.entry.data
---

<div class="grid gap-x-12 md:grid-cols-12" data-grid-projects>
  <div class="hidden md:col-span-5 md:block">
    <div class="sticky top-[18svh]">
      <div class="frame aspect-square w-full" data-grid-panel aria-hidden="true"></div>
      <p class="text-muted mt-4 text-sm" aria-hidden="true" data-grid-panel-caption>
        {first ? `${first.title}, ${period(first)}` : ''}
      </p>
    </div>
  </div>

  <ol class="border-line border-t md:col-span-7">
    {projects.map(({ slug, entry }) => {
      const project = entry.data
      return (
        <li class="border-line border-b">
          <a
            href={pathFor(locale, { key: 'project', slug })}
            class="project-row group grid grid-cols-[1fr_auto] gap-x-5 gap-y-4 py-6 md:block md:py-7"
            data-grid-row
            data-grid-glyph={project.glyph}
            data-caption={`${project.title}, ${period(project)}`}
          >
            <div>
              <Heading class="font-pixel text-d1 md:text-d2">
                <span class="inline-block" data-grid-row-title>
                  {project.title}
                </span>
              </Heading>
              <p class="text-fg mt-2 max-w-[44ch] md:mt-3">{project.summary}</p>
            </div>
            <div class="frame size-24 md:hidden" data-grid-glyph-box aria-hidden="true" />
            <p class="text-muted col-span-2 flex flex-wrap gap-x-4 gap-y-1 text-sm md:mt-4">
              <span class="tabular-nums">{period(project)}</span>
              {project.stack.map((item) => (
                <span>{item}</span>
              ))}
            </p>
          </a>
        </li>
      )
    })}
  </ol>
</div>

<style>
  .project-row [data-grid-row-title] {
    transition: color 120ms steps(3, end);
  }
  .project-row[data-active] [data-grid-row-title] {
    color: var(--signal);
  }
  .project-row:focus-visible {
    outline-offset: 6px;
  }
</style>
