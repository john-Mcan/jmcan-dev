---
import ProjectList from '@/components/projects/ProjectList.astro'
import { fill, getDictionary, pathFor, type Locale } from '@/i18n'
import type { Project } from '@/lib/projects'

interface Props {
  locale: Locale
  projects: Project[]
  total: number
}

const { locale, projects, total } = Astro.props
const t = getDictionary(locale)
---

<section class="container-site py-20 md:py-28" aria-labelledby="featured-title">
  <div class="mb-10 flex flex-wrap items-end justify-between gap-4 md:mb-14">
    <h2 id="featured-title" class="font-pixel text-d1 sm:text-d2">
      <span class="inline-block" data-grid-shape>
        {t.projects.featuredTitle}
      </span>
    </h2>
    <a class="link text-muted hover:text-fg" href={pathFor(locale, 'projects')}>
      {fill(t.projects.seeAll, { count: total })}
    </a>
  </div>
  <ProjectList locale={locale} projects={projects} />
</section>
