---
/**
 * El hero: el texto a la izquierda y un escenario vivo en todo el hero, alrededor.
 * Por defecto, cosmos solo (la materia cae a un tornado que queda solo) y el fondo
 * entra con el barrido de las otras páginas. `/lab` lo monta con otros patrones
 * para compararlos. El H1 lleva el nombre y el oficio, chicos, y el titular; desde
 * `md:`, cada línea del titular va entera, aunque pase del ancho de la columna: a su
 * derecha solo hay fondo.
 */
import HeroAsk from '@/components/sections/home/HeroAsk.astro'
import { SITE } from '@/data/site'
import { fill, getDictionary, type Locale } from '@/i18n'
import type { CursorMode } from '@/lib/grid-field/live'
import type { LivePattern } from '@/lib/grid-field/live-patterns'

interface Props {
  locale: Locale
  pattern?: LivePattern
  cursor?: CursorMode
  /** Cómo entra el fondo: con un fundido o con el barrido de siempre. */
  intro?: 'fade' | 'sweep'
}

const { locale, pattern = 'cosmos-alone', cursor = 'attract', intro = 'sweep' } = Astro.props
const t = getDictionary(locale)
const kicker = fill(t.hero.kicker, { name: SITE.name })
---

<section
  data-grid-stage={`live:${pattern}`}
  data-grid-cursor={cursor}
  data-grid-intro={intro === 'fade' ? 'fade' : undefined}
  data-prompt=""
>
  <div class="container-site grid min-h-[calc(100svh-var(--header-h))] content-center py-10 md:grid-cols-12 md:gap-x-10">
    <div class="md:col-span-6">
      <h1>
        <span class="mb-4 block w-fit text-base sm:mb-5 sm:text-lg" data-grid-island>
          {kicker}
        </span>
        {/* Para quien lo escucha: «John Mcan, full-stack developer. Desarrollemos tu idea». */}
        <span class="sr-only">. </span>
        <span
          class="font-pixel text-d2 sm:text-d3 md:text-d4 lg:text-d5 inline-block"
          data-grid-shape
        >
          {t.hero.title.map((line) => (
            <span class="block text-balance md:whitespace-nowrap">{`${line} `}</span>
          ))}
        </span>
      </h1>
      <p class="text-fg-soft mt-5 mb-9 max-w-[30ch] text-lg text-pretty sm:text-lead sm:mt-6 sm:mb-10">
        <span data-grid-island class="inline-block">
          {t.hero.lead}
        </span>
      </p>
      <HeroAsk locale={locale} />
    </div>
  </div>
</section>
