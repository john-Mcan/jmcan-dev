---
/**
 * El llamado del hero: «¿qué construimos?» con un input que lleva a /contacto con
 * el mensaje ya escrito (`?m=`, lo lee `ContactForm`), más «Ver proyectos» y la
 * disponibilidad. Todo es isla, y los recuadros son transparentes (`.live-open` en
 * `global.css`): el fondo vivo pasa por debajo.
 */
import Button from '@/components/ui/Button.astro'
import { getDictionary, pathFor, type Locale } from '@/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getDictionary(locale)
---

<div class="live-open flex flex-col items-start gap-6">
  <form class="w-full max-w-md" action={pathFor(locale, 'contact')} method="get" data-grid-island>
    <label for="hero-ask" class="font-pixel text-d1">
      <span class="text-muted" aria-hidden="true">
        &gt;
      </span>{' '}
      {t.hero.ask}
    </label>
    <div class="mt-3 flex gap-3">
      <input
        id="hero-ask"
        name="m"
        class="field"
        autocomplete="off"
        placeholder={t.hero.askPlaceholder}
      />
      <button class="btn btn-primary" type="submit">
        {t.hero.askSubmit}
      </button>
    </div>
  </form>
  <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
    <Button href={pathFor(locale, 'projects')}>{t.hero.ctaProjects}</Button>
    <p class="text-muted flex items-center gap-3 text-sm" data-grid-island>
      <span class="signal-dot" aria-hidden="true"></span>
      {t.hero.status}
    </p>
  </div>
</div>
