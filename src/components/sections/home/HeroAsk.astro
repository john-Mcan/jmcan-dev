---
/**
 * El llamado del hero: una pregunta con un input que lleva a /contacto con el
 * mensaje ya escrito (`?m=`, lo lee `ContactForm`), más «Ver proyectos» y la
 * disponibilidad. La pregunta rota tecla a tecla (`hero.asks`), como el prompt del
 * header, y cada una cambia el ejemplo del input; la última trae un enlace a la
 * radio. Todo es isla, y los recuadros son transparentes (`.live-open` en
 * `global.css`): el fondo vivo pasa por debajo.
 */
import Button from '@/components/ui/Button.astro'
import { getDictionary, pathFor, type Locale } from '@/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getDictionary(locale)
const asks = t.hero.asks
const [first] = asks
---

<div class="live-open flex flex-col items-start gap-6">
  <form class="w-full" action={pathFor(locale, 'contact')} method="get" data-hero-ask>
    <label for="hero-ask" class="ask font-pixel text-d1" data-grid-island>
      {/* Todas las preguntas, invisibles en la misma celda: reservan el alto de la más larga. */}
      <span class="ask-lines">
        {asks.map((ask) => (
          <span class="ask-ghost" aria-hidden="true" data-ask data-placeholder={ask.placeholder}>
            {ask.text}
            {'link' in ask && (
              <a class="link" href={ask.link.href} rel="noopener" target="_blank">
                {ask.link.text}
              </a>
            )}
          </span>
        ))}
        <span>
          <span data-ask-line>{first.text}</span>
          <span class="ask-cursor" aria-hidden="true"></span>
        </span>
      </span>
    </label>
    <div class="mt-3 flex max-w-md gap-3" data-grid-island>
      <input
        id="hero-ask"
        name="m"
        class="field"
        autocomplete="off"
        aria-label={first.text}
        placeholder={first.placeholder}
      />
      <button class="btn btn-primary" type="submit">
        {t.hero.askSubmit}
      </button>
    </div>
  </form>
  <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
    <Button href={pathFor(locale, 'projects')}>{t.hero.ctaProjects}</Button>
    <p class="text-muted flex items-center gap-3 text-sm" data-grid-island>
      <span class="signal-dot" aria-hidden="true"></span>
      {t.hero.status}
    </p>
  </div>
</div>

<style>
  .ask {
    display: block;
    width: fit-content;
    max-width: 100%;
  }
  .ask-lines {
    display: grid;
  }
  /*
   * Abajo en la celda, junto al input: una pregunta de una línea queda en la fila de
   * abajo y una de dos empieza ahí y sube al cortarse. El `>` abre la primera línea y
   * la segunda queda alineada con el texto (sangría francesa de 2ch: `>` y un espacio).
   */
  .ask-lines > * {
    grid-area: 1 / 1;
    align-self: end;
    padding-left: 2ch;
    text-indent: -2ch;
  }
  .ask-lines > *::before {
    content: '>';
    content: '>' / '';
    margin-right: 1ch;
    color: var(--muted);
  }
  /* Desde `md:`, en una línea, como el nombre: a su derecha solo hay fondo. */
  @media (min-width: 48rem) {
    .ask {
      max-width: none;
    }
    .ask-lines {
      white-space: nowrap;
    }
  }
  .ask-ghost {
    visibility: hidden;
  }
  /*
   * El cursor aparece solo mientras escribe y no parpadea: el que parpadea es el del header.
   * No ocupa ancho (el margen negativo lo compensa) y sobresale al margen: así nunca salta solo
   * a otra línea y la pregunta escrita corta las líneas igual que su reserva.
   */
  .ask-cursor {
    display: inline-block;
    width: 0.5em;
    height: 0.8em;
    margin-left: 0.125em;
    margin-right: -0.625em;
    background: var(--signal);
    visibility: hidden;
  }
  .ask[data-typing] .ask-cursor {
    visibility: visible;
  }
</style>

<script>
  import { createTypewriter, partsOf, type Typewriter } from '@/lib/typewriter'

  /** Cuánto queda escrita cada pregunta, y cada cuánto vuelve a mirar si puede seguir (ms). */
  const HOLD_MS = 4500
  const RETRY_MS = 600

  let stop: (() => void) | null = null

  /**
   * Rota la pregunta mientras el hero esté a la vista. Espera, con la pregunta
   * completa, si el puntero o el foco están en el formulario o si ya hay algo
   * escrito: no cambia lo que alguien está leyendo, respondiendo o por tocar. Con
   * movimiento reducido queda la primera.
   */
  function rotate(): void {
    stop?.()
    stop = null
    const form = document.querySelector<HTMLFormElement>('[data-hero-ask]')
    const label = form?.querySelector<HTMLElement>('label')
    const line = form?.querySelector<HTMLElement>('[data-ask-line]')
    const input = form?.querySelector('input')
    if (!form || !label || !line || !input) return
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

    const asks = Array.from(form.querySelectorAll<HTMLElement>('[data-ask]'), (ghost) => ({
      parts: partsOf(ghost),
      placeholder: ghost.dataset['placeholder'] ?? '',
    }))
    const writer: Typewriter = createTypewriter(line, label)
    let index = 0
    let timer = 0
    let visible = true

    const held = () =>
      !visible || document.hidden || input.value !== '' || form.matches(':hover, :focus-within')

    const next = (): void => {
      if (held()) {
        timer = window.setTimeout(next, RETRY_MS)
        return
      }
      index = (index + 1) % asks.length
      const ask = asks[index]
      if (!ask) return
      writer.type(ask.parts, () => {
        input.placeholder = ask.placeholder
        timer = window.setTimeout(next, HOLD_MS)
      })
    }

    const observer = new IntersectionObserver(([entry]) => {
      visible = entry?.isIntersecting ?? false
    })
    observer.observe(form)
    timer = window.setTimeout(next, HOLD_MS)
    stop = () => {
      window.clearTimeout(timer)
      writer.stop()
      observer.disconnect()
    }
  }

  document.addEventListener('astro:page-load', rotate)
  document.addEventListener('astro:before-swap', () => {
    stop?.()
    stop = null
  })
</script>
