---
/**
 * Subir un nivel: del detalle a proyectos, de proyectos o contacto al inicio. Sube,
 * no vuelve en el historial: quien llega directo a una página (desde un buscador o
 * un enlace compartido) saldría del sitio. Va arriba del título, a la izquierda,
 * donde se la busca, con el tamaño del texto y un área de toque de 44 px.
 */
interface Props {
  href: string
  /** Lo que se ve: la página a la que sube («Inicio», «Proyectos»). */
  label: string
  /** Lo que se lee: incluye `label` («Volver al inicio»). */
  name: string
}

const { href, label, name } = Astro.props
---

<a class="up-link" href={href} aria-label={name}>
  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
    <path d="M14 8H3M7.5 3.5 3 8l4.5 4.5" />
  </svg>
  <span>{label}</span>
</a>

<style>
  .up-link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg);
    font-weight: 500;
  }
  .up-link svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: square;
  }
  .up-link span {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    transition: text-decoration-color 120ms steps(3, end);
  }
  .up-link:hover span {
    text-decoration-color: var(--signal);
  }
</style>
