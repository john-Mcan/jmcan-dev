---
/**
 * El fondo del sitio. Persiste entre navegaciones (ClientRouter): la grilla nunca
 * se reinicia, se disuelve y se re-condensa sobre la página nueva.
 */
---

<div
  id="grid-field"
  class="grid-field"
  aria-hidden="true"
  transition:persist="grid-field"
  transition:name="grid-field"
  transition:animate="none"
>
  <canvas></canvas>
</div>

<style>
  .grid-field {
    position: fixed;
    /* Alto fijo (lvh) y no `inset: 0`: en móvil la barra del navegador se encoge al
       hacer scroll y, con `inset: 0`, el fondo cambiaba de alto en cada cuadro; cada
       cambio re-mide el canvas, lo borra y la grilla parpadeaba. Lo que queda bajo
       la barra no se ve. */
    inset: 0 0 auto;
    height: 100lvh;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    contain: strict;
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { mountGridField } from '@/scripts/grid-field'

  mountGridField()
</script>
